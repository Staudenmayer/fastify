{
  "name": "vue",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "main": "./out/main/index.js",
  "homepage": "https://github.com",
  "scripts": {
    "dev": "vite",
    "dev:electron": "electron-vite dev",
    "build": "run-p type-check \"build-only {@}\" --",
    "build:electron": "npm run type-check && electron-vite build",
    "build:electron:unpack": "npm run build:electron && electron-builder --dir",
    "build:electron:win": "npm run build:electron && electron-builder --win",
    "build:electron:mac": "npm run build:electron && electron-builder --mac",
    "build:electron:linux": "npm run build:electron && electron-builder --linux",
    "preview": "vite preview",
    "build-only": "vite build",
    "postinstall": "electron-builder install-app-deps",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint . --fix",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "electron-updater": "^6.3.9",
    "@fontsource/roboto": "5.2.7",
    "@iconify/vue": "^5.0.0",
    "@mdi/font": "7.4.47",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-web": "^0.55.0",
    "@opentelemetry/context-zone": "^2.4.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.211.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.211.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.210.0",
    "@opentelemetry/instrumentation": "^0.210.0",
    "@opentelemetry/resources": "^2.4.0",
    "@opentelemetry/sdk-logs": "^0.211.0",
    "@opentelemetry/sdk-metrics": "^2.5.0",
    "@opentelemetry/sdk-trace-base": "^2.4.0",
    "@opentelemetry/sdk-trace-web": "^2.4.0",
    "@opentelemetry/semantic-conventions": "^1.39.0",
    "@vueuse/core": "^14.1.0",
    "@vueuse/integrations": "^14.1.0",
    "axios": "^1.13.4",
    "cesium": "^1.138.0",
    "eslint-config-prettier": "^10.1.8",
    "highcharts": "^12.5.0",
    "highcharts-vue": "^2.0.1",
    "interactjs": "^1.10.27",
    "pinia": "^3.0.3",
    "posthog-js": "^1.328.0",
    "universal-cookie": "7",
    "uuid": "^13.0.0",
    "vite-plugin-static-copy": "^3.2.0",
    "vue": "^3.5.21",
    "vue-i18n": "^11.2.8",
    "vue-router": "^4.5.1",
    "vuetify": "^3.10.1"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tsconfig/node22": "^22.0.0",
    "@types/node": "^22.9.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.35.0",
    "eslint-config-vuetify": "^4.2.0",
    "npm-run-all2": "^8.0.4",
    "sass-embedded": "^1.92.1",
    "typescript": "~5.9.2",
    "unplugin-auto-import": "^20.1.0",
    "unplugin-fonts": "^1.4.0",
    "unplugin-vue-components": "^29.0.0",
    "unplugin-vue-router": "^0.15.0",
    "vite": "^7.1.5",
    "vite-plugin-vue-layouts-next": "^1.0.0",
    "vite-plugin-vuetify": "^2.1.2",
    "vue-tsc": "^3.2.0",
    "prettier": "^3.8.1"
  }
