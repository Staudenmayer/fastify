{
  "name": "fastify",
  "type": "module",
  "private": true,
  "workspaces": [
    "ui",
    "api"
  ],
  "scripts": {
    "dev": "bunx concurrently \"bun run dev:ui\" \"bun run dev:api\"",
    "build": "bun run --workspaces build",
    "dev:ui": "bun run --cwd=ui dev",
    "dev:api": "bun run --cwd=api dev",
    "format:api": "biome format . --write",
    "lint:api": "biome lint .",
    "check:api": "biome check . --write"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.5",
    "concurrently": "^9.2.1"
  }
}
